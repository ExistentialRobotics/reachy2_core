<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="box">
    <gravity>0 0 -9.8</gravity>

    <!-- Physics engine -->
    <physics default="1" name="default_physics" type="dart">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <bullet>
        <solver>
          <iters>50</iters>
          <min_step_size>0.0001</min_step_size>
          <sor>1.3</sor>
          <type>quick</type>
        </solver>
        <constraints>
          <contact_surface_layer>0.001</contact_surface_layer>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <split_impulse>1</split_impulse>
          <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
        </constraints>
      </bullet>
      <max_contacts>20</max_contacts>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Simple Table.
         x = 0.95 puts the near edge at 0.45 m from the robot's origin (the top
         is 1.0 x 0.8, so the edge is half a metre in front of the model pose).
         At the previous 1.5 the near edge was at 1.0 m and the table was pure
         scenery: the arms' in-limits envelope tops out near torso x = 0.45, so
         nothing the planner could reach ever came near it. 0.45 is the same
         reach the shelf world uses for its front face (0.475). -->
    <model name="table">
      <pose>0.95 0 0 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>2.0</ixx>
            <iyy>2.0</iyy>
            <izz>2.0</izz>
          </inertia>
        </inertial>
        <collision name="table_top_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry>
            <box>
              <size>1.0 0.8 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="table_top_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry>
            <box>
              <size>1.0 0.8 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
        
        <!-- Table legs -->
        <collision name="leg1_collision">
          <pose>0.45 0.35 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg1_visual">
          <pose>0.45 0.35 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <collision name="leg2_collision">
          <pose>-0.45 0.35 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg2_visual">
          <pose>-0.45 0.35 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <collision name="leg3_collision">
          <pose>0.45 -0.35 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg3_visual">
          <pose>0.45 -0.35 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        
        <collision name="leg4_collision">
          <pose>-0.45 -0.35 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg4_visual">
          <pose>-0.45 -0.35 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box on table -->
    <model name="box_on_table">
      <pose>1.5 0.2 1.0 0 0 0</pose> <!-- Sitting on table -->
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.016667</ixx>
            <iyy>0.016667</iyy>
            <izz>0.016667</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Tall box on table -->
    <model name="tall_box_on_table">
      <pose>1.3 -0.2 1.075 0 0 0</pose> <!-- Sitting on table -->
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.0225</ixx>
            <iyy>0.0225</iyy>
            <izz>0.005625</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 0.15 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 0.15 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>